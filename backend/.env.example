# CloudWise Backend Environment Variables Template
# Database Configuration
DB_PASSWORD=your_postgres_password

# Authentication & Security
JWT_SECRET=your_base64_encoded_jwt_secret_min_256_bits

# AI / OpenRouter
OPENROUTER_API_KEY=your_openrouter_api_key

# CloudWise Platform AWS Trust Principal ARN
# Local development default: arn:aws:iam::748076390893:user/cloudwise-local-dev
# Production: set to the actual IAM role ARN of the deployed CloudWise backend
CLOUDWISE_TRUST_PRINCIPAL_ARN=arn:aws:iam::748076390893:user/cloudwise-local-dev
